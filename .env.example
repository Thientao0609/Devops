# Run python scripts/init-env.py; never use placeholder values as real credentials.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
DATABASE_URL=postgresql+psycopg://clinic:REPLACE@localhost:5433/clinic
RABBITMQ_URL=amqp://clinic:REPLACE@localhost:5673/clinic-dev
JWT_SECRET=
DEMO_PASSWORD=
ENVIRONMENT=development
QUEUE_PREFIX=clinic.dev
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=clinic@example.test
RETRY_SECONDS=10,30,60
# Application design: optional email reminder, minutes before appointment (1..1440).
REMINDER_LEAD_MINUTES=60
